# Dependencies
node_modules/

# npm build output
*.tgz

# Logs and local scratch
*.log
.DS_Store
Thumbs.db

# Raw screen recordings and intermediate frames — only the processed media in
# assets/ is committed. `media/` holds full-window captures that run to tens of
# megabytes and are rebuilt by scripts/make-media.py.
media/

# Editor
.vscode/
.idea/

# Local npm cache used for sandboxed runs
.npm-cache/

# Local test scratch + node compile cache (never commit either)
.testtmp/
node-compile-cache/

# Local publishing notes — kept out of the public repo
PUBLISHING.md
MARKETPLACE.md

# A graft index built locally while working in this repo
graft/

# Raw image-generation output for the icon source (the derived icon.png ships)
dsh-image-gen/

# Profile lockfile pnpm leaves behind; this package has no dependencies
pnpm-lock.yaml
.relnotes.md

# Regenerated by the graft indexer when it runs in this repo; not ours to track
.ignore
